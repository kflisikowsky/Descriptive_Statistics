    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"# Tip Data\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Description\\n\",\n",
    "    \"\\n\",\n",
    "    \"A waiter recorded information about every tip he received over the course of several months working at a single restaurant.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Format\\n\",\n",
    "    \"\\n\",\n",
    "    \"A data table with 244 rows and 7 variables\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Details\\n\",\n",
    "    \"\\n\",\n",
    "    \"- tip in dollars,\\n\",\n",
    "    \"- bill in dollars,\\n\",\n",
    "    \"- gender of the person paying the bill,\\n\",\n",
    "    \"- whether there were smokers in the group,\\n\",\n",
    "    \"- day of the week,\\n\",\n",
    "    \"- time of day,\\n\",\n",
    "    \"- group size.\\n\",\n",
    "    \"\\n\",\n",
    "    \"In total, he recorded 244 tips. The data were published in a collection of case studies for business statistics (Bryant & Smith 1995).\\n\",\n",
    "    \"\\n\",\n",
    "    \"### References\\n\",\n",
    "    \"\\n\",\n",
    "    \"Bryant, P. G. and Smith, M (1995) Practical Data Analysis: Case Studies in Business Statistics. Homewood, IL: Richard D. Irwin Publishing:\"\n",
    "   ],\n",
    "   \"metadata\": {\n",
    "    \"id\": \"2bFjq_C7Q2Je\"\n",
    "   }\n",
    "  },\n",
